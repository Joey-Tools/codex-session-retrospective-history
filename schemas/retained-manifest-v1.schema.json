{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "coverage_gap": {
      "additionalProperties": false,
      "not": {
        "anyOf": [
          {
            "required": ["root"]
          },
          {
            "required": ["path"]
          }
        ]
      },
      "properties": {
        "bytes": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "host": {
          "$ref": "#/$defs/safe_token"
        },
        "reason": {
          "enum": [
            "auth_gated",
            "codex_missing",
            "history_missing",
            "history_unreadable",
            "host_unreachable",
            "invalid_jsonl",
            "missing_codex",
            "no_rollout_or_summary_files",
            "oversized_rollout_skipped",
            "partial_host_scope",
            "remote_source_not_materialized",
            "session_index_missing",
            "session_index_unreadable",
            "source_root_missing",
            "stale_host",
            "unreachable"
          ]
        },
        "root_ref": {
          "$ref": "#/$defs/path_ref"
        }
      },
      "required": ["host", "reason"],
      "type": "object"
    },
    "path_ref": {
      "description": "Opaque per-run keyed reference generated by the redaction policy; plain hashes are not retained-safe.",
      "pattern": "^path_ref_v1:[0-9a-f]{16}$",
      "type": "string"
    },
    "safe_token": {
      "maxLength": 64,
      "not": {
        "anyOf": [
          {
            "pattern": "\\b(?:[A-Za-z0-9-]+\\.)+(?:[Ii][Nn][Tt][Ee][Rr][Nn][Aa][Ll]|[Cc][Oo][Rr][Pp]|[Ll][Oo][Cc][Aa][Ll]|[Ll][Aa][Nn]|[Ee][Xx][Aa][Mm][Pp][Ll][Ee]|[Ii][Nn][Vv][Aa][Ll][Ii][Dd]|[Tt][Ee][Ss][Tt])\\b"
          },
          {
            "pattern": "\\b(?:sk|rk)[-_](?:proj[-_])?[A-Za-z0-9_-]{16,}\\b"
          },
          {
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        ]
      },
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "source_summary": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            },
            "required": ["status"]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "rollout_count": {
                    "minimum": 1
                  }
                },
                "required": ["rollout_count"]
              },
              {
                "properties": {
                  "summary_count": {
                    "minimum": 1
                  }
                },
                "required": ["summary_count"]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["empty", "missing", "stale"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "rollout_count": {
                "const": 0
              },
              "summary_count": {
                "const": 0
              }
            },
            "required": ["rollout_count", "summary_count"]
          }
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": ["root"]
          },
          {
            "required": ["path"]
          }
        ]
      },
      "properties": {
        "host": {
          "$ref": "#/$defs/safe_token"
        },
        "rollout_count": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "root_ref": {
          "$ref": "#/$defs/path_ref"
        },
        "status": {
          "enum": ["empty", "missing", "ready", "stale"]
        },
        "summary_count": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["host", "root_ref", "status", "rollout_count", "summary_count"],
      "type": "object"
    },
    "timestamp_or_null": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/timestamp_required"
        }
      ]
    },
    "timestamp_required": {
      "format": "date-time",
      "pattern": "^\\d{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12]\\d|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-9]))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Privacy gate schema for retained Codex session retrospective source manifests.",
  "not": {
    "anyOf": [
      {
        "required": ["root"]
      },
      {
        "required": ["path"]
      }
    ]
  },
  "properties": {
    "coverage_gaps": {
      "items": {
        "$ref": "#/$defs/coverage_gap"
      },
      "maxItems": 100,
      "type": "array"
    },
    "mode": {
      "$ref": "#/$defs/safe_token"
    },
    "redaction_policy_version": {
      "const": 1
    },
    "retention_note": {
      "const": "Derived retained manifest; raw location fields removed and opaque refs preserved."
    },
    "retention_safe": {
      "const": true
    },
    "schema_version": {
      "const": 1
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/source_summary"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/timestamp_required"
        },
        "mode": {
          "$ref": "#/$defs/safe_token"
        },
        "start": {
          "$ref": "#/$defs/timestamp_required"
        }
      },
      "required": ["mode", "start", "end"],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "window",
    "sources",
    "coverage_gaps",
    "redaction_policy_version",
    "retention_note",
    "retention_safe"
  ],
  "title": "Retained Session Retrospective Manifest v1",
  "type": "object"
}
