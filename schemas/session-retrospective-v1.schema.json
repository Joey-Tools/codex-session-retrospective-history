{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "count_map": {
      "additionalProperties": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
      },
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/safe_token"
      },
      "type": "object"
    },
    "coverage_gap": {
      "additionalProperties": false,
      "not": {
        "anyOf": [
          {
            "required": ["root"]
          },
          {
            "required": ["path"]
          }
        ]
      },
      "properties": {
        "bytes": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "host": {
          "$ref": "#/$defs/safe_token"
        },
        "reason": {
          "enum": [
            "auth_gated",
            "codex_missing",
            "history_missing",
            "history_unreadable",
            "host_unreachable",
            "invalid_jsonl",
            "missing_codex",
            "no_rollout_or_summary_files",
            "oversized_rollout_skipped",
            "partial_host_scope",
            "remote_source_not_materialized",
            "session_index_missing",
            "session_index_unreadable",
            "source_root_missing",
            "stale_host",
            "unreachable"
          ]
        },
        "root_ref": {
          "$ref": "#/$defs/path_ref"
        }
      },
      "required": ["host", "reason"],
      "type": "object"
    },
    "episode": {
      "additionalProperties": false,
      "properties": {
        "cwd": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/path_ref"
            }
          ]
        },
        "end": {
          "$ref": "#/$defs/timestamp_or_null"
        },
        "episode_id": {
          "$ref": "#/$defs/episode_ref"
        },
        "friction_flags": {
          "items": {
            "$ref": "#/$defs/safe_token"
          },
          "maxItems": 16,
          "type": "array"
        },
        "host": {
          "$ref": "#/$defs/safe_token"
        },
        "model_era": {
          "$ref": "#/$defs/safe_token"
        },
        "outcome": {
          "enum": ["needs_review", "no_issue_observed"]
        },
        "session_id": {
          "$ref": "#/$defs/session_ref"
        },
        "start": {
          "$ref": "#/$defs/timestamp_or_null"
        },
        "topic": {
          "$ref": "#/$defs/retained_text"
        },
        "turn_count": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "work_report_hint": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/retained_text"
            }
          ]
        }
      },
      "required": [
        "episode_id",
        "host",
        "session_id",
        "start",
        "end",
        "cwd",
        "model_era",
        "topic",
        "turn_count",
        "friction_flags",
        "outcome",
        "work_report_hint"
      ],
      "type": "object"
    },
    "manifest": {
      "additionalProperties": false,
      "not": {
        "anyOf": [
          {
            "required": ["root"]
          },
          {
            "required": ["path"]
          }
        ]
      },
      "properties": {
        "coverage_gaps": {
          "items": {
            "$ref": "#/$defs/coverage_gap"
          },
          "maxItems": 100,
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/safe_token"
        },
        "redaction_policy_version": {
          "const": 1
        },
        "retention_note": {
          "const": "Derived retained manifest; raw location fields removed and opaque refs preserved."
        },
        "retention_safe": {
          "const": true
        },
        "schema_version": {
          "const": 1
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/source_summary"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "window": {
          "$ref": "#/$defs/window"
        }
      },
      "required": [
        "schema_version",
        "mode",
        "window",
        "sources",
        "coverage_gaps",
        "redaction_policy_version",
        "retention_note",
        "retention_safe"
      ],
      "type": "object"
    },
    "path_ref": {
      "description": "Opaque per-run keyed reference generated by the redaction policy; plain hashes are not retained-safe.",
      "pattern": "^path_ref_v1:[0-9a-f]{16}$",
      "type": "string"
    },
    "episode_ref": {
      "description": "Opaque episode reference generated by the redaction policy; plain hashes and raw identifiers are not retained-safe.",
      "pattern": "^episode_ref_v1:[0-9a-f]{20}$",
      "type": "string"
    },
    "safe_token": {
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "retained_text": {
      "maxLength": 1200,
      "not": {
        "anyOf": [
          {
            "pattern": "\\b(?:[Hh][Tt][Tt][Pp][Ss]?|[Ss][Ss][Hh])://"
          },
          {
              "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"
            },
            {
              "pattern": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----"
            },
            {
              "pattern": "(^|[^A-Za-z0-9_])(?:~|/(?:Users|home|root|private|tmp|var|etc|opt|Volumes|workspace|workspaces))/"
            },
          {
            "pattern": "(^|[^A-Za-z0-9_])(?:\\./|\\.\\./)?\\.codex(?:-local|-tmp)?(?:/|\\\\)"
          },
          {
            "pattern": "(^|[^A-Za-z0-9_])(?:sessions|archived_sessions)(?:/|\\\\)"
          },
          {
            "pattern": "\\b[A-Za-z]:\\\\(?:Users|home|root|private|tmp|var|etc|opt|workspace|workspaces)\\\\"
          },
          {
            "pattern": "\\b(?:[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn])\\s*[:=]"
          },
          {
            "pattern": "\\b[Bb][Ee][Aa][Rr][Ee][Rr]\\s+[A-Za-z0-9._~+/=-]{12,}\\b"
          },
          {
            "pattern": "\\b(?:sk|rk)[-_](?:proj[-_])?[A-Za-z0-9_-]{16,}\\b"
          },
          {
            "pattern": "(^|[^0-9a-fA-F])[0-9a-fA-F]{64}([^0-9a-fA-F]|$)"
          },
          {
            "pattern": "\\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\b"
          },
          {
            "pattern": "\\brollout(?:-summary)?-[A-Za-z0-9_.-]+\\.jsonl\\b"
          },
          {
            "pattern": "\\b(?:[Ss]ession|[Tt]urn|[Ee]pisode)[-_ ]?[Ii][Dd]\\s*[:=]\\s*[\"']?(?!session_ref_v1:|turn_ref_v1:|episode_ref_v1:)[A-Za-z0-9_.:-]{6,}\\b"
          }
        ]
      },
      "type": "string"
    },
    "session_ref": {
      "description": "Opaque session reference generated by the redaction policy; plain hashes and raw identifiers are not retained-safe.",
      "pattern": "^session_ref_v1:[0-9a-f]{20}$",
      "type": "string"
    },
    "source_summary": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            },
            "required": ["status"]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "rollout_count": {
                    "minimum": 1
                  }
                },
                "required": ["rollout_count"]
              },
              {
                "properties": {
                  "summary_count": {
                    "minimum": 1
                  }
                },
                "required": ["summary_count"]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["empty", "missing", "stale"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "rollout_count": {
                "const": 0
              },
              "summary_count": {
                "const": 0
              }
            },
            "required": ["rollout_count", "summary_count"]
          }
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": ["root"]
          },
          {
            "required": ["path"]
          }
        ]
      },
      "properties": {
        "host": {
          "$ref": "#/$defs/safe_token"
        },
        "rollout_count": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "root_ref": {
          "$ref": "#/$defs/path_ref"
        },
        "status": {
          "enum": ["empty", "missing", "ready", "stale"]
        },
        "summary_count": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["host", "root_ref", "status", "rollout_count", "summary_count"],
      "type": "object"
    },
    "timestamp_or_null": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/timestamp_required"
        }
      ]
    },
    "timestamp_required": {
      "format": "date-time",
      "pattern": "^\\d{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12]\\d|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-9]))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$",
      "type": "string"
    },
    "turn_ref": {
      "description": "Opaque turn reference generated by the redaction policy; plain hashes and raw identifiers are not retained-safe.",
      "pattern": "^turn_ref_v1:[0-9a-f]{20}$",
      "type": "string"
    },
    "trend": {
      "additionalProperties": false,
      "properties": {
        "coverage_gaps": {
          "items": {
            "$ref": "#/$defs/coverage_gap"
          },
          "maxItems": 100,
          "type": "array"
        },
        "episode_count": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "flagged_turn_count": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "flags": {
          "$ref": "#/$defs/count_map"
        },
        "hosts": {
          "$ref": "#/$defs/count_map"
        },
        "model_eras": {
          "$ref": "#/$defs/count_map"
        },
        "schema_version": {
          "const": 1
        },
        "turn_count": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "window": {
          "$ref": "#/$defs/window"
        }
      },
      "required": [
        "schema_version",
        "window",
        "turn_count",
        "flagged_turn_count",
        "episode_count",
        "flags",
        "hosts",
        "model_eras",
        "coverage_gaps"
      ],
      "type": "object"
    },
    "turn_flag": {
      "additionalProperties": false,
      "properties": {
        "assistant_action_summary": {
          "$ref": "#/$defs/retained_text"
        },
        "cwd": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/path_ref"
            }
          ]
        },
        "episode_id": {
          "$ref": "#/$defs/episode_ref"
        },
        "host": {
          "$ref": "#/$defs/safe_token"
        },
        "issue_flags": {
          "items": {
            "$ref": "#/$defs/safe_token"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/safe_token"
            }
          ]
        },
        "model_era": {
          "$ref": "#/$defs/safe_token"
        },
        "prompt_improvement": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/retained_text"
            }
          ]
        },
        "redacted_user_prompt_summary": {
          "$ref": "#/$defs/retained_text"
        },
        "session_id": {
          "$ref": "#/$defs/session_ref"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_path": {
          "$ref": "#/$defs/path_ref"
        },
        "timestamp": {
          "$ref": "#/$defs/timestamp_or_null"
        },
        "turn_id": {
          "$ref": "#/$defs/turn_ref"
        }
      },
      "required": [
        "turn_id",
        "episode_id",
        "host",
        "session_id",
        "source_path",
        "source_hash",
        "timestamp",
        "cwd",
        "model",
        "model_era",
        "redacted_user_prompt_summary",
        "assistant_action_summary",
        "issue_flags",
        "prompt_improvement"
      ],
      "type": "object"
    },
    "window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/timestamp_required"
        },
        "mode": {
          "$ref": "#/$defs/safe_token"
        },
        "start": {
          "$ref": "#/$defs/timestamp_required"
        }
      },
      "required": ["mode", "start", "end"],
      "type": "object"
    }
  },
  "description": "Schema bundle for redacted Codex session retrospective artifacts.",
  "oneOf": [
    {
      "$ref": "#/$defs/episode"
    },
    {
      "$ref": "#/$defs/turn_flag"
    },
    {
      "$ref": "#/$defs/trend"
    }
  ],
  "title": "Session Retrospective v1"
}
